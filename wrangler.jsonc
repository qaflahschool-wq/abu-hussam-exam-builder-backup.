{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abu-hussam-exam-builder-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "QUESTION_IMAGES",
      "bucket_name": "abu-hussam-exam-builder-staging"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abu-hussam-exam-builder-staging",
      "database_id": "204dbdf9-5ae5-4ea3-a701-176e31bafe06",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
