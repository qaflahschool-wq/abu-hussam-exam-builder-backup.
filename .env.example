# Copy to .env locally and replace every placeholder with a strong, private value.
NODE_ENV=production
PORT=3000

# Generate a unique random value of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated exact browser origins, without trailing slashes.
CORS_ALLOWED_ORIGINS=https://your-domain.example

# Set only when exactly this many trusted reverse-proxy hops exist.
# Leave 0 when the app is directly exposed.
TRUST_PROXY_HOPS=0

# Required only when using Gemini AI.
GEMINI_API_KEY=

# Used when the production database is first created and to rotate legacy demo credentials.
# Use unique passwords of at least 12 characters; do not reuse these elsewhere.
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_SCHOOL_ADMIN_PASSWORD=
BOOTSTRAP_TEACHER_PASSWORD=
BOOTSTRAP_TEACHER2_PASSWORD=
